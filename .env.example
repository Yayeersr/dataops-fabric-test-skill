# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก .gitignore ไว้แล้ว ห้าม commit ไฟล์ที่มีค่าจริง)
# ค่าจริงเอามาจาก Service Principal ตัวเดียวกับที่ตั้งเป็น GitHub Actions secret ของ repo นี้
# (Settings → Secrets and variables → Actions) — ถามเจ้าของ SP ถ้าไม่มีสิทธิ์ดู
#
# ใช้กับ scripts/deploy.py / scripts/run_live_dq_item.py (ถ้าอยากรันทดสอบ local แทน CI)
# scripts/deploy_local.py ไม่ต้องใช้ค่าพวกนี้ เพราะ login ผ่าน browser ตรงๆ (InteractiveBrowserCredential) อยู่แล้ว

FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
